# Copier en .env pour le développement local — aucune valeur réelle ici (dépôt public).

# IMPORTANT en déploiement (Vercel ou autre) : poser ENVIRONMENT=production (ou preview/test)
# explicitement sur la plateforme, dans les variables du projet. Ne PAS compter uniquement sur
# le défaut — celui-ci reste "local" si la variable est oubliée. Filet de sécurité : sur Vercel,
# la plateforme injecte automatiquement VERCEL=1 (non déclaratif, jamais oubliable), que
# core/config.py détecte pour forcer le mode distant (secrets obligatoires, cookie Secure,
# désactivation des instructions préparées pour PgBouncer) même si ENVIRONMENT a été oubliée.
# Hors Vercel (autre plateforme), il n'existe aucun filet équivalent : ENVIRONMENT doit être
# posée à la main.
ENVIRONMENT=local

# PostgreSQL — docker-compose expose le port 5433 en local pour ne pas heurter une instance
# locale existante. En production : chaîne "pooled" (PgBouncer) de Neon pour DATABASE_URL,
# chaîne directe pour DATABASE_URL_DIRECT (migrations + REFRESH CONCURRENTLY, plan.md § 3.8).
DATABASE_URL=postgresql+psycopg://cardan:cardan@localhost:5433/cardan
DATABASE_URL_DIRECT=postgresql+psycopg://cardan:cardan@localhost:5433/cardan

# Authentification (plan.md § 3.4) — générer une valeur aléatoire forte en local/prod,
# jamais la valeur d'exemple. Laissé vide ici : en environment=local, une valeur de secours
# explicitement locale et signalée (log warning) s'applique automatiquement (voir core/config.py).
# Hors local (test/preview/production), l'application REFUSE DE DÉMARRER si absent.
JWT_SECRET=

# Cron nocturne Vercel — Authorization: Bearer $CRON_SECRET (plan.md § 3.8-7). Même règle de
# fail-fast que JWT_SECRET hors environment=local.
CRON_SECRET=

# Stockage photos — Supabase Storage, projet en région UE (décision C), utilisé à partir de J2
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=cardan-photos

# Enrichissement société par SIRET (décision B)
# recherche_entreprises (défaut, sans clé) | insee (nécessite INSEE_API_KEY) | disabled
COMPANY_LOOKUP_PROVIDER=recherche_entreprises
INSEE_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]
