# Copier en .env pour le développement local — aucune valeur réelle ici (dépôt public).

# IMPORTANT en déploiement (Vercel ou autre) : poser ENVIRONMENT=production (ou preview/test)
# explicitement sur la plateforme, dans les variables du projet. Ne PAS compter uniquement sur
# le défaut — celui-ci reste "local" si la variable est oubliée. Filet de sécurité : sur Vercel,
# la plateforme injecte automatiquement VERCEL=1 (non déclaratif, jamais oubliable), que
# core/config.py détecte pour forcer le mode distant (secrets obligatoires, cookie Secure,
# désactivation des instructions préparées pour PgBouncer) même si ENVIRONMENT a été oubliée.
# Hors Vercel (autre plateforme), il n'existe aucun filet équivalent : ENVIRONMENT doit être
# posée à la main.
ENVIRONMENT=local

# PostgreSQL — docker-compose expose le port 5433 en local pour ne pas heurter une instance
# locale existante. En production (Supabase) : DATABASE_URL prend la chaîne « Transaction
# pooler » (Supavisor, port 6543, compatible PgBouncer — l'API tourne dessus, pool_size=1 de
# `app/db/session.py`), DATABASE_URL_DIRECT prend la connexion directe (port 5432 — migrations
# Alembic et `REFRESH MATERIALIZED VIEW ... CONCURRENTLY`, qu'un pooler en mode transaction ne
# supporte pas). Voir `docs/wiki/deploiement.md` pour où récupérer exactement ces deux chaînes
# dans le tableau de bord Supabase (Project Settings → Database → Connection string).
DATABASE_URL=postgresql+psycopg://cardan:cardan@localhost:5433/cardan
DATABASE_URL_DIRECT=postgresql+psycopg://cardan:cardan@localhost:5433/cardan

# Authentification (plan.md § 3.4) — générer une valeur aléatoire forte en local/prod,
# jamais la valeur d'exemple. Laissé vide ici : en environment=local, une valeur de secours
# explicitement locale et signalée (log warning) s'applique automatiquement (voir core/config.py).
# Hors local (test/preview/production), l'application REFUSE DE DÉMARRER si absent.
JWT_SECRET=

# Cron nocturne Vercel — Authorization: Bearer $CRON_SECRET (plan.md § 3.8-7). Même règle de
# fail-fast que JWT_SECRET hors environment=local.
CRON_SECRET=

# Stockage photos — colonnes posées en J1 (décision C), abstraction `PhotoStorage` posée en J2.
# Backend choisi par CONFIGURATION, jamais par une variable dédiée : `LocalDiskStorage` tant que
# SUPABASE_URL/SUPABASE_SERVICE_KEY ne sont pas TOUTES LES DEUX renseignées (développement local,
# CI, tests — aucune clé requise, le disque local ne dégrade jamais un clone du dépôt), sinon
# `SupabaseStorage` (`app/services/storage/service.py::get_storage_backend`). En production :
# SUPABASE_URL est l'URL du projet (Project Settings → API → Project URL), SUPABASE_SERVICE_KEY
# est la clé **service_role** (Project Settings → API → Project API keys — jamais la clé
# `anon`/publique : elle seule contourne les policies RLS du bucket pour un backend qui écrit
# pour le compte de tous les utilisateurs). Voir `docs/wiki/deploiement.md` pour la marche à
# suivre complète, dont la création manuelle du bucket (le code ne la fait jamais).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=cardan-photos
# Racine du stockage local, relative à backend/ si non absolue (gitignorée : backend/var/) —
# ignorée dès que SUPABASE_URL/SUPABASE_SERVICE_KEY sont toutes deux renseignées.
LOCAL_STORAGE_DIR=var/storage

# Notifications web push (brief J2) — la notification en base (pastille, liste) fonctionne sans
# aucune clé. Le push réel ne s'active que si les DEUX clés VAPID sont renseignées ; laissées
# vides ici, la démo reste pleinement fonctionnelle (arbitrage « web push optionnel »).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@cardan.local

# Enrichissement société par SIRET (décision B)
# recherche_entreprises (défaut, sans clé) | insee (nécessite INSEE_API_KEY) | disabled
COMPANY_LOOKUP_PROVIDER=recherche_entreprises
INSEE_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]
